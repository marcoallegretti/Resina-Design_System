      {"path":"/minimumHitTarget","value":{"minimumWidth":24,"minimumHeight":24}}
    ]
  },
  {
    "name":"full quality and shaped backdrop capabilities",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"full"},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"shapedBackdrop"}]
  },
  {
    "name":"balanced quality keeps regular backdrop",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"balanced"},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"regularBackdrop"}]
  },
  {
    "name":"reduced transparency overrides shaped backdrop",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"full"},
      {"path":"/environment/accessibilityPreferences/reducedTransparency","value":true},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"opaqueDimensional"}]
  },
  {
