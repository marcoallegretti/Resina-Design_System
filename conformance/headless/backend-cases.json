[
  {"name":"baseline semantic resolution","outcome":"valid"},
  {
    "name":"user text scale respects each role minimum",
    "outcome":"valid",
    "requestChanges":[{"path":"/environment/textScale","value":1}],
    "expectedChanges":[
      {"path":"/typography/display/fontSize/value","value":20.0},
      {"path":"/typography/display/letterSpacing/value","value":0.25},
      {"path":"/typography/titleLarge/fontSize/value","value":20.0},
      {"path":"/typography/titleLarge/letterSpacing/value","value":0.25},
      {"path":"/typography/title/fontSize/value","value":20.0},
      {"path":"/typography/title/letterSpacing/value","value":0.25},
      {"path":"/typography/heading/fontSize/value","value":20.0},
      {"path":"/typography/heading/letterSpacing/value","value":0.25},
      {"path":"/typography/bodyLarge/fontSize/value","value":20.0},
      {"path":"/typography/bodyLarge/letterSpacing/value","value":0.25},
      {"path":"/typography/body/fontSize/value","value":20.0},
      {"path":"/typography/body/letterSpacing/value","value":0.25},
      {"path":"/typography/label/fontSize/value","value":20.0},
      {"path":"/typography/label/letterSpacing/value","value":0.25},
      {"path":"/typography/caption/fontSize/value","value":25.0},
      {"path":"/typography/caption/letterSpacing/value","value":0.3125},
      {"path":"/typography/numeric/fontSize/value","value":20.0},
      {"path":"/typography/numeric/letterSpacing/value","value":0.25},
      {"path":"/typography/code/fontSize/value","value":20.0},
      {"path":"/typography/code/letterSpacing/value","value":0.25}
    ]
  },
  {
    "name":"high contrast and keyboard preserve other resolved roles",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/accessibilityPreferences/highContrast","value":true},
      {"path":"/environment/inputCapabilities","value":["keyboard"]}
    ],
    "expectedChanges":[
      {"path":"/frostRepresentation","value":"opaqueDimensional"},
      {"path":"/minimumHitTarget","value":{"minimumWidth":24,"minimumHeight":24}}
    ]
  },
  {
    "name":"full quality and shaped backdrop capabilities",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"full"},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"shapedBackdrop"}]
  },
  {
    "name":"balanced quality keeps regular backdrop",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"balanced"},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"regularBackdrop"}]
  },
  {
    "name":"reduced transparency overrides shaped backdrop",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"full"},
      {"path":"/environment/accessibilityPreferences/reducedTransparency","value":true},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"opaqueDimensional"}]
  },
  {
    "name":"backdrop flags cannot override missing translucency",
    "outcome":"valid",
    "requestChanges":[
      {"path":"/environment/qualityPolicy","value":"full"},
      {"path":"/environment/rendererCapabilities/translucentSurfaces","value":false},
      {"path":"/environment/rendererCapabilities/backdropEffect","value":true},
      {"path":"/environment/rendererCapabilities/backdropBlur","value":true},
      {"path":"/environment/rendererCapabilities/shapedBackdrop","value":true}
    ],
    "expectedChanges":[{"path":"/frostRepresentation","value":"opaqueDimensional"}]
  },
  {
    "name":"unknown semantic color token rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/colorAssignments/roles/focus","value":"missing.color"}]
  },
  {
    "name":"invalid DTCG dimension rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/tokens/type/size/$value/unit","value":"em"}]
  },
  {
    "name":"out-of-gamut source without fallback rejects the request",
    "outcome":"invalid",
    "requestChanges":[
      {"path":"/tokens/palette/base/$value/colorSpace","value":"display-p3"},
      {"path":"/tokens/palette/base/$value/components","value":[1,0,0]}
    ]
  },
  {
    "name":"duplicate input capability rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/environment/inputCapabilities/0","value":"keyboard"}]
  },
  {
    "name":"translucent semantic color retains a distinct opaque fallback",
    "outcome":"valid",
    "requestChanges":[{"path":"/colorAssignments/roles/focus","value":"palette.translucent"}],
    "expectedChanges":[
      {"path":"/colors/focus","value":{"colorSpace":"display-p3","components":[0.25,0.5,0.75],"hex":"#336699","alpha":0.35}},
      {"path":"/colorFallbacks/focus","value":{"colorSpace":"srgb","components":[0.2,0.4,0.6],"alpha":0.35}}
    ]
  },
  {
    "name":"authored opaque tone takes precedence for one role",
    "outcome":"valid",
    "requestChanges":[{"path":"/opaqueColorAssignments/roles/focus","value":"palette.opaqueAlt"}],
    "expectedChanges":[{"path":"/opaqueColorFallbacks/focus","value":{"colorSpace":"srgb","components":[0.8,0.7,0.6],"alpha":1.0}}]
  },
  {
    "name":"missing authored opaque token rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/opaqueColorAssignments/roles/focus","value":"palette.missing"}]
  },
  {
    "name":"translucent authored opaque token rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/tokens/palette/opaque/$value","value":{"colorSpace":"srgb","components":[0.15,0.2,0.3],"alpha":0.5}}]
  },
  {
    "name":"Frost pigment strength is preserved in semantic resolution",
    "outcome":"valid",
    "requestChanges":[{"path":"/frostPigment/tintStrength","value":0.8}],
    "expectedChanges":[{"path":"/frostTintStrength","value":0.8}]
  },
  {
    "name":"invalid Frost pigment strength rejects the request",
    "outcome":"invalid",
    "requestChanges":[{"path":"/frostPigment/tintStrength","value":1}]
  },
  {
    "name":"duplicate opaque color role rejects the source",
    "outcome":"invalid",
    "sourceReplace":{
      "find":"\"focus\": \"palette.opaque\",\n      \"selection\"",
      "with":"\"focus\": \"palette.opaque\",\n      \"focus\": \"palette.opaqueAlt\",\n      \"selection\""
    }
  },
  {
    "name":"duplicate JSON member rejects the source",
    "outcome":"invalid",
    "sourceReplace":{
      "find":"{\n  \"schemaVersion\": \"0.3.0\",\n  \"tokens\"",
      "with":"{\n  \"schemaVersion\": \"0.3.0\",\n  \"schemaVersion\": \"0.3.0\",\n  \"tokens\""
    }
  },
  {
    "name":"unsupported headless request version is rejected",
    "outcome":"invalid",
    "requestChanges":[{"path":"/schemaVersion","value":"0.2.0"}]
  }
]
