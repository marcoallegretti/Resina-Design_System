  "locale": "en-US",
  "layoutDirection": "ltr",
  "rendererCapabilities": { "gradients": true, "innerShadow": false, "advancedShadow": false, "sdfShapes": false, "backdropEffect": false, "backdropBlur": false, "shapedBackdrop": false, "dynamicLighting": false, "deformation": false, "masks": false, "customShader": false, "wideGamut": false, "hdr": false },
  "qualityPolicy": "economy"
}
