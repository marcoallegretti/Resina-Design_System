[
  {
    "name": "source resolves aliases and inherited types",
    "source": "{\"$type\":\"number\",\"base\":{\"$value\":2},\"alias\":{\"$value\":\"{base}\"}}",
    "expected": {
      "base": {
        "token_type": "number",
        "value": 2
      },
      "alias": {
        "token_type": "number",
        "value": 2
      }
    }
  },
  {
    "name": "decimal boundaries survive token resolution",
    "source": "{\"$type\":\"number\",\"belowOne\":{\"$value\":0.9999999999999999},\"aboveOne\":{\"$value\":1.0000000000000002},\"smallestPositive\":{\"$value\":4.9406564584124654e-324},\"largestFinite\":{\"$value\":1.7976931348623157e308},\"alias\":{\"$value\":\"{belowOne}\"}}",
    "expected": {
      "belowOne": {"token_type": "number", "value": 0.9999999999999999},
      "aboveOne": {"token_type": "number", "value": 1.0000000000000002},
      "smallestPositive": {"token_type": "number", "value": 4.9406564584124654e-324},
      "largestFinite": {"token_type": "number", "value": 1.7976931348623157e308},
      "alias": {"token_type": "number", "value": 0.9999999999999999}
    }
  },
  {
    "name": "overflowing number fails before token resolution",
    "source": "{\"token\":{\"$type\":\"number\",\"$value\":1e400}}",
    "stage": "parse",
    "error": "number out of range"
  },
  {
    "name": "duplicate token property fails before resolution",
    "source": "{\"token\":{\"$type\":\"number\",\"$value\":1,\"$value\":2}}",
    "stage": "parse",
    "error": "duplicate JSON member at #/token/$value"
  },
  {
    "name": "malformed source fails before resolution",
    "source": "{\"token\":",
    "stage": "parse",
    "error": "EOF while parsing a value"
  },
  {
    "name": "missing declared type fails resolution",
    "source": "{\"plain\":{\"$value\":2}}",
    "stage": "resolve",
    "error": "MissingType",
    "location": "#/plain"
  },
  {
    "name": "invalid resolved value fails resolution",
    "source": "{\"gap\":{\"$type\":\"dimension\",\"$value\":{\"value\":2,\"unit\":\"em\"}}}",
    "stage": "resolve",
    "error": "InvalidValue",
    "location": "#/gap/$value/unit"
  },
  {
    "name": "pointer to token object fails value validation",
    "source": "{\"base\":{\"$type\":\"number\",\"$value\":2},\"alias\":{\"$type\":\"number\",\"$ref\":\"#/base\"}}",
    "stage": "resolve",
    "error": "InvalidValue",
    "location": "#/alias/$ref"
  },
  {
    "name": "curly alias to ref-only token fails resolution",
    "source": "{\"source\":{\"$type\":\"number\",\"$value\":2},\"base\":{\"$type\":\"number\",\"$ref\":\"#/source/$value\"},\"alias\":{\"$type\":\"number\",\"$value\":\"{base}\"}}",
    "stage": "resolve",
    "error": "InvalidReference",
    "location": "#/base/$value"
  },
  {
    "name": "missing curly target value wins over a type mismatch",
    "source": "{\"source\":{\"$type\":\"number\",\"$value\":2},\"base\":{\"$type\":\"number\",\"$ref\":\"#/source/$value\"},\"alias\":{\"$type\":\"color\",\"$value\":\"{base}\"}}",
    "stage": "resolve",
    "error": "InvalidReference",
    "location": "#/base/$value"
  }
]
