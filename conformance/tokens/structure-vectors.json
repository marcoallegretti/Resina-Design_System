[
  {
    "name": "nested groups and root token",
    "document": {
      "color": {
        "$type": "color",
        "accent": {
          "$root": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8] } },
          "muted": { "$value": "{color.accent.$root}", "$deprecated": false }
        }
      }
    }
  },
  {
    "name": "empty group and extension syntax",
    "document": {
      "base": {},
      "derived": { "$extends": "{base}", "$description": "Reserved for variants" }
    }
  },
  {
    "name": "document root must be an object",
    "document": [],
    "error": "InvalidRoot"
  },
  {
    "name": "invalid token name",
    "document": { "color.primary": { "$type": "number", "$value": 1 } },
    "error": "InvalidName"
  },
  {
    "name": "unknown group property",
    "document": { "group": { "$backend": "renderer" } },
    "error": "UnknownProperty"
  },
  {
    "name": "token cannot have children",
    "document": { "control": { "$value": 1, "$type": "number", "child": { "$value": 2 } } },
    "error": "TokenWithChildren"
  },
  {
    "name": "root token must be a token",
    "document": { "group": { "$root": { "child": { "$value": 1 } } } },
    "error": "InvalidRootToken"
  },
  {
    "name": "invalid type metadata",
    "document": { "value": { "$value": 1, "$type": "string" } },
    "error": "InvalidMetadata"
  },
  {
    "name": "invalid deprecation metadata",
    "document": { "value": { "$value": 1, "$type": "number", "$deprecated": 10 } },
    "error": "InvalidMetadata"
  },
  {
    "name": "invalid extension reference syntax",
    "document": { "group": { "$extends": "{broken" } },
    "error": "InvalidReference"
  },
  {
    "name": "invalid token pointer syntax",
    "document": { "value": { "$ref": "#/bad/~2", "$type": "number" } },
    "error": "InvalidReference"
  },
  {
    "name": "child must be an object",
    "document": { "group": { "child": 42 } },
    "error": "InvalidNode"
  }
]
