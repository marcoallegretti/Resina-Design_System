{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:translucent-frost-request:0.1.0",
  "title": "Resina Translucent Frost Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "theme",
    "surface",
    "size",
    "appearance",
    "foregroundRole",
    "diffusion",
    "backdrop",
    "adjacentRanges",
    "minimumContentContrast",
    "minimumEdgeContrast"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "theme": {"$ref": "urn:resina:schema:theme-resolution-request:0.1.0"},
    "surface": {"$ref": "urn:resina:schema:surface-binding:0.2.0"},
    "size": {"$ref": "urn:resina:schema:surface-size:0.1.0"},
    "appearance": {"$ref": "urn:resina:schema:opaque-surface-appearance:0.1.0"},
    "foregroundRole": {"$ref": "urn:resina:schema:surface-binding:0.2.0#/properties/colorRole"},
    "diffusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["radius"],
      "properties": {"radius": {"type": "number", "exclusiveMinimum": 0}}
    },
    "backdrop": {"$ref": "urn:resina:schema:opaque-srgb-range:0.1.0"},
    "adjacentRanges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:resina:schema:opaque-srgb-range:0.1.0"}
    },
    "surroundingRanges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:resina:schema:opaque-srgb-range:0.1.0"}
    },
    "minimumContentContrast": {"type": "number", "minimum": 1, "maximum": 21},
    "minimumEdgeContrast": {"type": "number", "minimum": 1, "maximum": 21}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface": {
            "properties": {
              "states": {"properties": {"states": {"contains": {"const": "focused"}}}}
            }
          }
        }
      },
      "then": {"required": ["surroundingRanges"]}
    }
  ]
}
