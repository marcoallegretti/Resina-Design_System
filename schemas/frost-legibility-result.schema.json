{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:frost-legibility-result:0.1.0",
  "title": "Resina Frost Legibility Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "representation", "body", "compositedBody", "contrastRatio", "fallbackApplied"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "representation": {"enum": ["shapedBackdrop", "regularBackdrop", "translucentPigmented", "opaqueDimensional"]},
    "body": {"$ref": "urn:resina:schema:srgb-fallback:0.1.0"},
    "compositedBody": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
    "contrastRatio": {"type": "number", "minimum": 1, "maximum": 21},
    "fallbackApplied": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"representation": {"const": "opaqueDimensional"}}},
      "then": {"properties": {"body": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"}}},
      "else": {"properties": {"body": {"properties": {"alpha": {"exclusiveMinimum": 0, "exclusiveMaximum": 1}}}}}
    },
    {
      "if": {"properties": {"fallbackApplied": {"const": true}}},
      "then": {"properties": {"representation": {"const": "opaqueDimensional"}}}
    }
  ]
}
