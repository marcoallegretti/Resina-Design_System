{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:slider-part-paint-ir:0.1.0",
  "title": "Resina Slider Part Paint IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "part",
    "readOnly",
    "layoutDirection",
    "phase",
    "response",
    "paint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "part": {
      "enum": [
        "track",
        "thumb"
      ]
    },
    "readOnly": {
      "type": "boolean"
    },
    "layoutDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "phase": {
      "enum": [
        "rest",
        "hover",
        "pressed",
        "dragging",
        "disabled",
        "readOnly",
        "readOnlyHover"
      ]
    },
    "response": {
      "$ref": "urn:resina:schema:command-appearance:0.1.0#/$defs/response"
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "body"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1.0"
        },
        "body": {
          "$ref": "urn:resina:schema:slider-part-body-ir:0.1.0"
        },
        "focus": {
          "$ref": "urn:resina:schema:focus-indicator-ir:0.1.0"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "paint": {
            "properties": {
              "body": {
                "properties": {
                  "states": {
                    "properties": {
                      "states": {
                        "contains": {
                          "const": "disabled"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "disabled"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "paint": {
              "properties": {
                "body": {
                  "properties": {
                    "states": {
                      "properties": {
                        "states": {
                          "contains": {
                            "const": "dragging"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "phase": {
              "const": "dragging"
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "pressed"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "pressed"
              }
            }
          },
          "else": {
            "if": {
              "allOf": [
                {
                  "properties": {
                    "readOnly": {
                      "const": true
                    }
                  }
                },
                {
                  "properties": {
                    "paint": {
                      "properties": {
                        "body": {
                          "properties": {
                            "states": {
                              "properties": {
                                "states": {
                                  "contains": {
                                    "const": "hover"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "phase": {
                  "const": "readOnlyHover"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "readOnly": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "phase": {
                    "const": "readOnly"
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "paint": {
                      "properties": {
                        "body": {
                          "properties": {
                            "states": {
                              "properties": {
                                "states": {
                                  "contains": {
                                    "const": "hover"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "phase": {
                      "const": "hover"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "phase": {
                      "const": "rest"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "part": {
                "const": "thumb"
              }
            }
          },
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "focused"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "paint": {
            "required": [
              "focus"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "paint": {
            "not": {
              "required": [
                "focus"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "rest"
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "const": {
              "bodyMix": 0,
              "depthScale": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "paint": {
            "properties": {
              "body": {
                "properties": {
                  "states": {
                    "properties": {
                      "states": {
                        "contains": {
                          "const": "dragging"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "paint": {
            "properties": {
              "body": {
                "properties": {
                  "states": {
                    "properties": {
                      "states": {
                        "contains": {
                          "const": "pressed"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "pressed"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "dragging"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "readOnly": {
            "const": false
          }
        },
        "not": {
          "properties": {
            "paint": {
              "properties": {
                "body": {
                  "properties": {
                    "states": {
                      "properties": {
                        "states": {
                          "contains": {
                            "const": "disabled"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "disabled"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "hover"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "paint": {
                "properties": {
                  "body": {
                    "properties": {
                      "states": {
                        "properties": {
                          "states": {
                            "contains": {
                              "const": "pressed"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "not": {
          "properties": {
            "paint": {
              "properties": {
                "body": {
                  "properties": {
                    "states": {
                      "properties": {
                        "states": {
                          "contains": {
                            "const": "rest"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "paint": {
            "properties": {
              "body": {
                "properties": {
                  "states": {
                    "properties": {
                      "states": {
                        "contains": {
                          "const": "rest"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
