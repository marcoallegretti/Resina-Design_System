{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-snapshot-cases:0.1.0",
  "title": "Resina Toggle Snapshot State Cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "activation",
          "hovered",
          "checked",
          "layoutChecked",
          "trackStates",
          "thumbStates",
          "coherent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "activation": {
            "$ref": "urn:resina:schema:activation-state:0.1.0"
          },
          "hovered": {
            "type": "boolean"
          },
          "checked": {
            "type": "boolean"
          },
          "layoutChecked": {
            "type": "boolean"
          },
          "coherent": {
            "type": "boolean"
          },
          "trackStates": {
            "$ref": "urn:resina:schema:state-set:0.1.0#/properties/states"
          },
          "thumbStates": {
            "$ref": "urn:resina:schema:state-set:0.1.0#/properties/states"
          }
        }
      }
    }
  }
}
