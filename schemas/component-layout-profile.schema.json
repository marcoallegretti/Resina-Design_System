{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:component-layout-profile:0.1.0",
  "title": "Resina Component Layout Profile",
  "oneOf": [
    { "$ref": "#/$defs/commandProfile" },
    { "$ref": "#/$defs/toggleProfile" }
  ],
  "$defs": {
    "commandProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "component", "padding", "extents"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "component": { "const": "command" },
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "top", "bottom"],
          "properties": {
            "start": { "$ref": "#/$defs/inlineInset" },
            "end": { "$ref": "#/$defs/inlineInset" },
            "top": { "$ref": "#/$defs/blockInset" },
            "bottom": { "$ref": "#/$defs/blockInset" }
          }
        },
        "extents": {
          "allOf": [{ "$ref": "#/$defs/densityModes" }],
          "additionalProperties": { "$ref": "#/$defs/extent" }
        }
      }
    },
    "toggleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "component", "parts"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "component": { "const": "toggle" },
        "parts": {
          "allOf": [{ "$ref": "#/$defs/densityModes" }],
          "additionalProperties": { "$ref": "#/$defs/toggleParts" }
        }
      }
    },
    "densityModes": {
      "type": "object",
      "required": ["compact", "standard", "comfortable", "immersive"],
      "propertyNames": { "enum": ["compact", "standard", "comfortable", "immersive"] }
    },
    "inlineInset": { "enum": ["space.control.inset.inline"] },
    "blockInset": { "enum": ["space.control.inset.block"] },
    "tokenPath": { "type": "string", "minLength": 1 },
    "sizeTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "$ref": "#/$defs/tokenPath" },
        "height": { "$ref": "#/$defs/tokenPath" }
      }
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSize", "maximumSize"],
      "properties": {
        "minimumSize": { "$ref": "#/$defs/sizeTokens" },
        "maximumSize": { "$ref": "#/$defs/sizeTokens" }
      }
    },
    "toggleParts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackSize", "thumbSize", "thumbInset"],
      "properties": {
        "trackSize": { "$ref": "#/$defs/sizeTokens" },
        "thumbSize": { "$ref": "#/$defs/sizeTokens" },
        "thumbInset": { "$ref": "#/$defs/tokenPath" }
      }
    }
  }
}
