{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-source:0.1.0",
  "title": "Resina Theme Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "materialAssignments", "frostPigment", "colorAssignments", "opaqueColorAssignments", "spatialAssignments", "typographyAssignments"],
  "oneOf": [
    {"required": ["tokens"], "not": {"anyOf": [{"required": ["tokenResolver"]}, {"required": ["tokenInput"]}]}},
    {"required": ["tokenResolver", "tokenInput"], "not": {"required": ["tokens"]}}
  ],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "tokens": {"type": "object"},
    "tokenResolver": {"type": "object"},
    "tokenInput": {"type": "object", "additionalProperties": {"type": "string"}},
    "materialAssignments": {"$ref": "urn:resina:schema:material-assignments:0.2.0"},
    "frostPigment": {"$ref": "urn:resina:schema:frost-pigment:0.1.0"},
    "colorAssignments": {"$ref": "urn:resina:schema:color-assignments:0.1.0"},
    "opaqueColorAssignments": {"$ref": "urn:resina:schema:opaque-color-assignments:0.1.0"},
    "spatialAssignments": {"$ref": "urn:resina:schema:spatial-assignments:0.1.0"},
    "typographyAssignments": {"$ref": "urn:resina:schema:typography-assignments:0.1.0"}
  }
}
