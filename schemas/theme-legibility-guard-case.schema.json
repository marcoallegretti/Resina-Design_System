{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-legibility-guard-case:0.1.0",
  "title": "Resina Authored Theme Legibility Guard Vectors",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "theme", "legibilityGuard"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "theme": {"enum": ["tokens/themes/light.json", "tokens/themes/dark.json"]},
      "legibilityGuard": {"$ref": "urn:resina:schema:theme-legibility-guard:0.1.0"}
    }
  }
}
