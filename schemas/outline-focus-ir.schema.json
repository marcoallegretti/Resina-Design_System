{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:outline-focus-ir:0.1.0",
  "title": "Resina Outline Focus IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indicator", "geometry"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "indicator": {"$ref": "urn:resina:schema:focus-indicator-result:0.1.0"},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline", "sideOffset", "innerOutset", "outerOutset", "silhouetteBounds", "innerBounds", "outerBounds"],
      "properties": {
        "outline": {"$ref": "urn:resina:schema:surface-outline-result:0.1.0"},
        "sideOffset": {"$ref": "#/$defs/vector"},
        "innerOutset": {"const": 2},
        "outerOutset": {"const": 4},
        "silhouetteBounds": {"$ref": "#/$defs/bounds"},
        "innerBounds": {"$ref": "#/$defs/bounds"},
        "outerBounds": {"$ref": "#/$defs/bounds"}
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
