{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:lit-control-scene-manifest:0.1.0",
  "title": "Resina Lit Control Scene Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "themes", "environmentSource", "appearanceSource", "reliefSource", "anatomy", "surroundingColorRole", "sizes", "lights", "environments", "capture", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "themes": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "externalSources", "responseSource"],
        "properties": {
          "source": {"$ref": "#/$defs/sourcePath"},
          "externalSources": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/sourcePath"}},
          "responseSource": {"$ref": "#/$defs/sourcePath"}
        }
      }
    },
    "environmentSource": {"$ref": "#/$defs/sourcePath"},
    "appearanceSource": {"$ref": "#/$defs/sourcePath"},
    "reliefSource": {"$ref": "#/$defs/sourcePath"},
    "anatomy": {
      "type": "object", "additionalProperties": false, "required": ["command", "toggle"],
      "properties": {"command": {"$ref": "#/$defs/sourcePath"}, "toggle": {"$ref": "#/$defs/sourcePath"}}
    },
    "surroundingColorRole": {"$ref": "urn:resina:schema:surface-binding:0.2.0#/properties/colorRole"},
    "sizes": {
      "type": "object", "additionalProperties": false, "required": ["command", "toggleTrack", "toggleThumb"],
      "properties": {"command": {"$ref": "#/$defs/size"}, "toggleTrack": {"$ref": "#/$defs/size"}, "toggleThumb": {"$ref": "#/$defs/size"}}
    },
    "lights": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "urn:resina:schema:command-paint-request:0.2.0#/properties/light"}
    },
    "environments": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["highContrast", "reducedMotion", "dynamicLighting", "qualityPolicy", "layoutDirection"],
        "properties": {
          "highContrast": {"type": "boolean"},
          "reducedMotion": {"type": "boolean"},
          "dynamicLighting": {"type": "boolean"},
          "qualityPolicy": {"$ref": "urn:resina:schema:environment:0.2.0#/properties/qualityPolicy"},
          "layoutDirection": {"enum": ["ltr", "rtl"]}
        }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["margin", "pixelsPerUnit", "samplesPerAxis"],
      "properties": {
        "margin": {"type": "number", "minimum": 8},
        "pixelsPerUnit": {"type": "number", "exclusiveMinimum": 0},
        "samplesPerAxis": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": {"pattern": "[\\r\\n]"}, "maxLength": 160},
    "sourcePath": {"type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.json$", "not": {"pattern": "[\\r\\n]"}},
    "size": {"allOf": [
      {"$ref": "urn:resina:schema:surface-size:0.1.0"},
      {"properties": {"width": {"exclusiveMinimum": 0}, "height": {"exclusiveMinimum": 0}}}
    ]},
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "theme", "component", "states", "light", "environment"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "theme": {"type": "string", "minLength": 1},
        "component": {"enum": ["command", "toggle"]},
        "variant": {"enum": ["standard", "primary"]},
        "part": {"enum": ["track", "thumb"]},
        "checked": {"type": "boolean"},
        "states": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["rest", "hover", "pressed", "disabled", "focused"]}
        },
        "light": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"component": {"const": "command"}}},
         "then": {"required": ["variant"], "not": {"anyOf": [{"required": ["part"]}, {"required": ["checked"]}]}},
         "else": {"required": ["part", "checked"], "not": {"required": ["variant"]}}}
      ]
    }
  }
}
