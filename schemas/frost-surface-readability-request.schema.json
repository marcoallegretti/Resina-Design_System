{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:frost-surface-readability-request:0.1.0",
  "title": "Resina Frost Surface Readability Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenario", "foregroundRole", "postTreatmentBackdrop", "adjacentColor", "minimumContentContrast", "minimumEdgeContrast"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "scenario": {"$ref": "urn:resina:schema:surface-scenario:0.4.0"},
    "foregroundRole": {"$ref": "urn:resina:schema:surface-binding:0.2.0#/properties/colorRole"},
    "postTreatmentBackdrop": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
    "adjacentColor": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
    "minimumContentContrast": {"type": "number", "minimum": 1, "maximum": 21},
    "minimumEdgeContrast": {"type": "number", "minimum": 1, "maximum": 21}
  }
}
