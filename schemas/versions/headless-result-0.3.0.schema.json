{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:headless-result:0.3.0",
  "title": "Resina Headless Semantic Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "materials",
    "colors",
    "colorFallbacks",
    "opaqueColorFallbacks",
    "space",
    "typography",
    "frostRepresentation",
    "minimumHitTarget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.3.0"
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface.base",
        "surface.content",
        "surface.chrome",
        "surface.raised",
        "surface.transient",
        "control.passive",
        "control.interactive",
        "control.primary",
        "feedback.focus",
        "feedback.selection",
        "feedback.drag"
      ],
      "properties": {
        "surface.base": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "surface.content": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "surface.chrome": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "surface.raised": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "surface.transient": {
          "enum": [
            "cast",
            "frost",
            "elastomer",
            "gel"
          ]
        },
        "control.passive": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "control.interactive": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "control.primary": {
          "enum": [
            "cast",
            "frost",
            "elastomer"
          ]
        },
        "feedback.focus": {
          "enum": [
            "cast",
            "frost",
            "elastomer",
            "gel"
          ]
        },
        "feedback.selection": {
          "enum": [
            "cast",
            "frost",
            "elastomer",
            "gel"
          ]
        },
        "feedback.drag": {
          "enum": [
            "cast",
            "frost",
            "elastomer",
            "gel"
          ]
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent.primary",
        "accent.secondary",
        "accent.tertiary",
        "surface.base",
        "surface.low",
        "surface.high",
        "surface.chrome",
        "content.primary",
        "content.secondary",
        "content.muted",
        "content.inverse",
        "outline",
        "outline.strong",
        "status.error",
        "status.warning",
        "status.success",
        "status.info",
        "focus",
        "selection"
      ],
      "properties": {
        "accent.primary": {
          "$ref": "#/$defs/color"
        },
        "accent.secondary": {
          "$ref": "#/$defs/color"
        },
        "accent.tertiary": {
          "$ref": "#/$defs/color"
        },
        "surface.base": {
          "$ref": "#/$defs/color"
        },
        "surface.low": {
          "$ref": "#/$defs/color"
        },
        "surface.high": {
          "$ref": "#/$defs/color"
        },
        "surface.chrome": {
          "$ref": "#/$defs/color"
        },
        "content.primary": {
          "$ref": "#/$defs/color"
        },
        "content.secondary": {
          "$ref": "#/$defs/color"
        },
        "content.muted": {
          "$ref": "#/$defs/color"
        },
        "content.inverse": {
          "$ref": "#/$defs/color"
        },
        "outline": {
          "$ref": "#/$defs/color"
        },
        "outline.strong": {
          "$ref": "#/$defs/color"
        },
        "status.error": {
          "$ref": "#/$defs/color"
        },
        "status.warning": {
          "$ref": "#/$defs/color"
        },
        "status.success": {
          "$ref": "#/$defs/color"
        },
        "status.info": {
          "$ref": "#/$defs/color"
        },
        "focus": {
          "$ref": "#/$defs/color"
        },
        "selection": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "colorFallbacks": {
      "type": "object",
      "required": [
        "accent.primary",
        "accent.secondary",
        "accent.tertiary",
        "surface.base",
        "surface.low",
        "surface.high",
        "surface.chrome",
        "content.primary",
        "content.secondary",
        "content.muted",
        "content.inverse",
        "outline",
        "outline.strong",
        "status.error",
        "status.warning",
        "status.success",
        "status.info",
        "focus",
        "selection"
      ],
      "propertyNames": {
        "enum": [
          "accent.primary",
          "accent.secondary",
          "accent.tertiary",
          "surface.base",
          "surface.low",
          "surface.high",
          "surface.chrome",
          "content.primary",
          "content.secondary",
          "content.muted",
          "content.inverse",
          "outline",
          "outline.strong",
          "status.error",
          "status.warning",
          "status.success",
          "status.info",
          "focus",
          "selection"
        ]
      },
      "additionalProperties": {
        "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
      }
    },
    "opaqueColorFallbacks": {
      "type": "object",
      "required": [
        "accent.primary", "accent.secondary", "accent.tertiary",
        "surface.base", "surface.low", "surface.high", "surface.chrome",
        "content.primary", "content.secondary", "content.muted", "content.inverse",
        "outline", "outline.strong",
        "status.error", "status.warning", "status.success", "status.info",
        "focus", "selection"
      ],
      "propertyNames": {
        "enum": [
          "accent.primary", "accent.secondary", "accent.tertiary",
          "surface.base", "surface.low", "surface.high", "surface.chrome",
          "content.primary", "content.secondary", "content.muted", "content.inverse",
          "outline", "outline.strong",
          "status.error", "status.warning", "status.success", "status.info",
          "focus", "selection"
        ]
      },
      "additionalProperties": {
        "$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space.control.inline",
        "space.control.block",
        "space.container.inner",
        "space.container.outer",
        "space.group",
        "space.section",
        "space.page"
      ],
      "properties": {
        "space.control.inline": {
          "$ref": "#/$defs/dimension"
        },
        "space.control.block": {
          "$ref": "#/$defs/dimension"
        },
        "space.container.inner": {
          "$ref": "#/$defs/dimension"
        },
        "space.container.outer": {
          "$ref": "#/$defs/dimension"
        },
        "space.group": {
          "$ref": "#/$defs/dimension"
        },
        "space.section": {
          "$ref": "#/$defs/dimension"
        },
        "space.page": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "titleLarge",
        "title",
        "heading",
        "bodyLarge",
        "body",
        "label",
        "caption",
        "numeric",
        "code"
      ],
      "properties": {
        "display": {
          "$ref": "#/$defs/typography"
        },
        "titleLarge": {
          "$ref": "#/$defs/typography"
        },
        "title": {
          "$ref": "#/$defs/typography"
        },
        "heading": {
          "$ref": "#/$defs/typography"
        },
        "bodyLarge": {
          "$ref": "#/$defs/typography"
        },
        "body": {
          "$ref": "#/$defs/typography"
        },
        "label": {
          "$ref": "#/$defs/typography"
        },
        "caption": {
          "$ref": "#/$defs/typography"
        },
        "numeric": {
          "$ref": "#/$defs/typography"
        },
        "code": {
          "$ref": "#/$defs/typography"
        }
      }
    },
    "frostRepresentation": {
      "enum": [
        "shapedBackdrop",
        "regularBackdrop",
        "translucentPigmented",
        "opaqueDimensional"
      ]
    },
    "minimumHitTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumWidth",
            "minimumHeight"
          ],
          "properties": {
            "minimumWidth": {
              "const": 24
            },
            "minimumHeight": {
              "const": 24
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumWidth",
            "minimumHeight"
          ],
          "properties": {
            "minimumWidth": {
              "const": 48
            },
            "minimumHeight": {
              "const": 48
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "unitComponent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "const": "none"
        }
      ]
    },
    "percentComponent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "const": "none"
        }
      ]
    },
    "hueComponent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        {
          "const": "none"
        }
      ]
    },
    "anyComponent": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "const": "none"
        }
      ]
    },
    "nonnegativeComponent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "none"
        }
      ]
    },
    "rgbComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/unitComponent"
        },
        {
          "$ref": "#/$defs/unitComponent"
        },
        {
          "$ref": "#/$defs/unitComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "hueComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/hueComponent"
        },
        {
          "$ref": "#/$defs/percentComponent"
        },
        {
          "$ref": "#/$defs/percentComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "labComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/percentComponent"
        },
        {
          "$ref": "#/$defs/anyComponent"
        },
        {
          "$ref": "#/$defs/anyComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "lchComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/percentComponent"
        },
        {
          "$ref": "#/$defs/nonnegativeComponent"
        },
        {
          "$ref": "#/$defs/hueComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "oklabComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/unitComponent"
        },
        {
          "$ref": "#/$defs/anyComponent"
        },
        {
          "$ref": "#/$defs/anyComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "oklchComponents": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/unitComponent"
        },
        {
          "$ref": "#/$defs/nonnegativeComponent"
        },
        {
          "$ref": "#/$defs/hueComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colorSpace",
        "components"
      ],
      "properties": {
        "colorSpace": {
          "enum": [
            "srgb",
            "srgb-linear",
            "display-p3",
            "a98-rgb",
            "prophoto-rgb",
            "rec2020",
            "xyz-d65",
            "xyz-d50",
            "hsl",
            "hwb",
            "lab",
            "lch",
            "oklab",
            "oklch"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "srgb",
                  "srgb-linear",
                  "display-p3",
                  "a98-rgb",
                  "prophoto-rgb",
                  "rec2020",
                  "xyz-d65",
                  "xyz-d50"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/rgbComponents"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "hsl",
                  "hwb"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/hueComponents"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "lab"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/labComponents"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "lch"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/lchComponents"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "oklab"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/oklabComponents"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "colorSpace": {
                "enum": [
                  "oklch"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "$ref": "#/$defs/oklchComponents"
              }
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "px",
            "rem"
          ]
        }
      }
    },
    "positivePx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "px"
        }
      }
    },
    "trackingPx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "px"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyRole",
        "fontSize",
        "fontWeight",
        "lineHeight",
        "letterSpacing"
      ],
      "properties": {
        "familyRole": {
          "enum": [
            "sans",
            "display",
            "monospace",
            "numeric"
          ]
        },
        "fontSize": {
          "$ref": "#/$defs/positivePx"
        },
        "fontWeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "letterSpacing": {
          "$ref": "#/$defs/trackingPx"
        }
      }
    }
  }
}
