{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:headless-resolution:0.2.0",
  "title": "Resina Headless Resolution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tokens", "materialAssignments", "colorAssignments", "opaqueColorAssignments", "spatialAssignments", "typographyAssignments", "environment"],
  "properties": {
    "schemaVersion": {"const": "0.2.0"},
    "tokens": {"type": "object"},
    "materialAssignments": {"$ref": "urn:resina:schema:material-assignments:0.2.0"},
    "colorAssignments": {"$ref": "urn:resina:schema:color-assignments:0.1.0"},
    "opaqueColorAssignments": {"$ref": "urn:resina:schema:opaque-color-assignments:0.1.0"},
    "spatialAssignments": {"$ref": "urn:resina:schema:spatial-assignments:0.1.0"},
    "typographyAssignments": {"$ref": "urn:resina:schema:typography-assignments:0.1.0"},
    "environment": {"$ref": "urn:resina:schema:environment:0.2.0"}
  }
}
