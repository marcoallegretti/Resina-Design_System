{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-motion-request:0.1.0",
  "title": "Resina Command Motion Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "commandAppearance",
    "channels",
    "time"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "surface": {
      "$ref": "urn:resina:schema:surface-paint-request:0.1.0"
    },
    "commandAppearance": {
      "$ref": "urn:resina:schema:command-appearance:0.1.0"
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodyMix",
        "depthScale"
      ],
      "properties": {
        "bodyMix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dynamics",
            "initial"
          ],
          "properties": {
            "dynamics": {
              "$ref": "urn:resina:schema:spring-dynamics:0.1.0"
            },
            "initial": {
              "$ref": "urn:resina:schema:spring-state:0.1.0"
            }
          }
        },
        "depthScale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dynamics",
            "initial"
          ],
          "properties": {
            "dynamics": {
              "$ref": "urn:resina:schema:spring-dynamics:0.1.0"
            },
            "initial": {
              "$ref": "urn:resina:schema:spring-state:0.1.0"
            }
          }
        }
      }
    },
    "time": {
      "type": "number",
      "minimum": 0
    }
  }
}
