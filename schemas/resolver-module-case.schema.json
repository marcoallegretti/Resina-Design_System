{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:resolver-module-case:0.1.0",
  "title": "Resina Resolver Module Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "resolver", "input", "externalSources"],
  "oneOf": [
    {"required": ["expected"], "not": {"required": ["errorContains"]}},
    {"required": ["errorContains"], "not": {"required": ["expected"]}}
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "resolver": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "externalSources": {"type": "object", "additionalProperties": {"type": "string"}},
    "expected": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token_type", "value"],
        "properties": {
          "token_type": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "errorContains": {"type": "string", "minLength": 1}
  }
}
