{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "paint",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "pigment",
        "direction",
        "edge",
        "edgeWidth",
        "foreground",
        "contentContrastRatio",
        "contentBounds"
      ],
      "properties": {
        "surface": {
          "$ref": "urn:resina:schema:surface-relief-result:0.1.0#/properties/surface"
        },
        "pigment": {
          "$ref": "urn:resina:schema:opaque-pigment-result:0.1.0"
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "edge": {
          "$ref": "urn:resina:schema:edge-contrast-result:0.1.0"
        },
        "edgeWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "foreground": {
          "$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"
        },
        "contentContrastRatio": {
          "type": "number",
          "minimum": 1,
          "maximum": 21
        },
        "contentBounds": {
          "$ref": "urn:resina:schema:surface-relief-result:0.1.0#/properties/surface/properties/contentBounds"
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point",
          "color"
        ],
        "properties": {
          "point": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "color": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:relief-paint-result:0.1.0",
  "title": "Resina Opaque Relief Paint Result"
}
