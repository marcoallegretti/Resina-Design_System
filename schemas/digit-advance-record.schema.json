{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:digit-advance-record:0.1.0",
  "title": "Resina Numeric Digit Advance Record",
  "description": "Measured logical advances of the digits 0 to 9, in that order, for text in the numeric typography role at one resolved font size.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "fontSize",
    "advances"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "role": {
      "const": "numeric"
    },
    "fontSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "px"
        }
      }
    },
    "advances": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  }
}
