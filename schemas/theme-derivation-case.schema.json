{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-derivation-case:0.1.0",
  "title": "Resina Theme Derivation Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "outcome", "requestSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["valid", "invalid"]},
    "requestSchemaValid": {"type": "boolean"},
    "seed": {},
    "templateVariant": {"const": "embeddedTokens"},
    "templateChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "path", "value"],
        "properties": {
          "theme": {"enum": ["light", "dark"]},
          "path": {"type": "string", "pattern": "^/"},
          "value": {}
        }
      }
    },
    "requestChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "value": {}
        }
      }
    },
    "requestOmit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "requestDocument": {},
    "failingThemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["light", "dark"]}
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "themes"],
      "properties": {
        "seed": {"$ref": "urn:resina:schema:theme-derivation-result:0.1.0#/$defs/seed"},
        "themes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {
            "light": {"$ref": "#/$defs/expectedTheme"},
            "dark": {"$ref": "#/$defs/expectedTheme"}
          }
        }
      }
    }
  },
  "$defs": {
    "expectedTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "legibilityGuard"],
      "properties": {
        "roles": {"$ref": "urn:resina:schema:theme-derivation-result:0.1.0#/$defs/roles"},
        "legibilityGuard": {"$ref": "urn:resina:schema:theme-legibility-guard:0.1.0"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "valid"}}},
      "then": {
        "required": ["seed", "expected"],
        "properties": {"requestSchemaValid": {"const": true}},
        "not": {"anyOf": [{"required": ["failingThemes"]}, {"required": ["requestDocument"]}]}
      }
    },
    {"if": {"properties": {"outcome": {"const": "invalid"}}}, "then": {"not": {"required": ["expected"]}}},
    {
      "if": {"required": ["requestDocument"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["seed"]},
            {"required": ["templateVariant"]},
            {"required": ["templateChanges"]},
            {"required": ["requestChanges"]},
            {"required": ["requestOmit"]}
          ]
        }
      }
    },
    {"if": {"required": ["failingThemes"]}, "then": {"properties": {"requestSchemaValid": {"const": true}}}}
  ]
}
