{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-resolution-case:0.1.0",
  "title": "Resina Theme Resolution Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "outcome", "requestSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["valid", "invalid"]},
    "requestSchemaValid": {"type": "boolean"},
    "sourceVariant": {"enum": ["resolverBackedInline", "foundationResolver"]},
    "omitFoundationSource": {"const": true},
    "sourceChanges": {"$ref": "#/$defs/changes"},
    "sourceReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "with"],
      "properties": {
        "find": {"type": "string", "minLength": 1},
        "with": {"type": "string"}
      }
    },
    "requestChanges": {"$ref": "#/$defs/changes"},
    "expectedChanges": {"$ref": "#/$defs/changes"}
  },
  "$defs": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "value": {}
        }
      }
    }
  },
  "allOf": [
    {"if": {"required": ["sourceReplace"]}, "then": {"not": {"required": ["sourceChanges"]}}},
    {"if": {"properties": {"outcome": {"const": "invalid"}}}, "then": {"not": {"required": ["expectedChanges"]}}},
    {"if": {"properties": {"outcome": {"const": "valid"}}}, "then": {"properties": {"requestSchemaValid": {"const": true}}}},
    {"if": {"required": ["omitFoundationSource"]}, "then": {"properties": {"sourceVariant": {"const": "foundationResolver"}}, "required": ["sourceVariant"]}}
  ]
}
