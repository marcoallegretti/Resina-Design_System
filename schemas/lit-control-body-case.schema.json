{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:lit-control-body-case:0.1.0",
  "title": "Resina Lit Control Body Point Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "sourceChanges", "sourceSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "sourceChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {"path": {"type": "string", "pattern": "^/"}, "value": {}}
      }
    },
    "sourceSchemaValid": {"type": "boolean"},
    "expected": {"$ref": "#/$defs/expected"},
    "errorContains": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {"required": ["expected"], "not": {"required": ["errorContains"]}, "properties": {"sourceSchemaValid": {"const": true}}},
    {"required": ["errorContains"], "not": {"required": ["expected"]}}
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "size", "radii", "relief", "body", "pigmentProfiles", "keyLight", "light",
        "environment", "edge", "edgeWidth", "foreground", "minimumContentContrast", "depth", "points"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "size": {"$ref": "urn:resina:schema:surface-size:0.1.0"},
        "radii": {"$ref": "urn:resina:schema:logical-corner-radii:0.1.0"},
        "relief": {"$ref": "urn:resina:schema:surface-relief-request:0.1.0#/$defs/profile"},
        "body": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
        "pigmentProfiles": {"$ref": "urn:resina:schema:opaque-pigment-profiles:0.1.0"},
        "keyLight": {"$ref": "urn:resina:schema:key-light:0.1.0"},
        "light": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ambient", "interaction"],
          "properties": {
            "ambient": {"$ref": "urn:resina:schema:material-light:0.1.0#/properties/ambient"},
            "interaction": {"$ref": "urn:resina:schema:material-light:0.1.0#/properties/interaction"}
          }
        },
        "environment": {"$ref": "urn:resina:schema:environment:0.2.0"},
        "edge": {"$ref": "urn:resina:schema:edge-contrast-request:0.1.0"},
        "edgeWidth": {"type": "number", "exclusiveMinimum": 0},
        "foreground": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
        "minimumContentContrast": {"type": "number", "minimum": 1, "maximum": 21},
        "depth": {"type": "number", "minimum": 0},
        "points": {"$ref": "#/$defs/points"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialRole", "colorRole", "materialFamily", "form", "states", "foregroundRole", "contentFallbackApplied"],
      "properties": {
        "materialRole": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/materialRole"},
        "colorRole": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/colorRole"},
        "materialFamily": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/materialFamily"},
        "form": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/form"},
        "states": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/states"},
        "frostRepresentation": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/frostRepresentation"},
        "foregroundRole": {"$ref": "urn:resina:schema:lit-control-body-ir:0.1.0#/properties/foregroundRole"},
        "contentFallbackApplied": {"type": "boolean"}
      },
      "if": {"properties": {"materialFamily": {"const": "frost"}}},
      "then": {"required": ["frostRepresentation"]},
      "else": {"not": {"required": ["frostRepresentation"]}, "properties": {"contentFallbackApplied": {"const": false}}}
    },
    "points": {
      "type": "array",
      "items": {"$ref": "#/$defs/point"}
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "sideOffset", "contentBounds", "colorRanges", "samples"],
      "properties": {
        "light": {"$ref": "urn:resina:schema:material-relief-paint-result:0.1.0#/properties/paint/properties/light"},
        "sideOffset": {"$ref": "#/$defs/point"},
        "contentBounds": {"$ref": "urn:resina:schema:material-relief-paint-result:0.1.0#/properties/paint/properties/contentBounds"},
        "colorRanges": {"$ref": "urn:resina:schema:material-relief-paint-result:0.1.0#/properties/paint/properties/colorRanges"},
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point", "rule", "color"],
            "properties": {
              "point": {"$ref": "#/$defs/point"},
              "rule": {"enum": [1, 2, 3, 4, 5, 6, 7]},
              "color": {"oneOf": [{"type": "null"}, {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"}]}
            },
            "if": {"properties": {"rule": {"const": 7}}},
            "then": {"properties": {"color": {"type": "null"}}},
            "else": {"properties": {"color": {"type": "object"}}}
          }
        }
      }
    }
  }
}
