{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-motion-case:0.1.0",
  "title": "Resina Command Motion Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "requestChanges",
    "requestSchemaValid"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "requestChanges": {
      "$ref": "urn:resina:schema:surface-paint-case:0.1.0#/properties/requestChanges"
    },
    "requestSchemaValid": {
      "type": "boolean"
    },
    "errorContains": {
      "type": "string",
      "minLength": 1
    },
    "expectedPolicy": {
      "enum": [
        "spring",
        "castImmediate",
        "reducedMotion"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "expectedPolicy"
      ],
      "not": {
        "required": [
          "errorContains"
        ]
      }
    },
    {
      "required": [
        "errorContains"
      ],
      "not": {
        "required": [
          "expectedPolicy"
        ]
      }
    }
  ]
}
