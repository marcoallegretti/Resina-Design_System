{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "begin",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "begin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "revision"
            ],
            "properties": {
              "value": {
                "$ref": "urn:resina:schema:slider-value-request:0.1.0"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "current",
                "revision",
                "enabled",
                "readOnly",
                "action"
              ],
              "properties": {
                "current": {
                  "$ref": "urn:resina:schema:slider-value-request:0.1.0"
                },
                "revision": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "readOnly": {
                  "type": "boolean"
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "layout",
                        "desiredOrigin"
                      ],
                      "properties": {
                        "kind": {
                          "const": "preview"
                        },
                        "layout": {
                          "$ref": "urn:resina:schema:slider-layout-cases:0.1.0#/properties/cases/items/properties/input"
                        },
                        "desiredOrigin": {
                          "type": "number"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "commit"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "cancel"
                        }
                      }
                    }
                  ]
                },
                "expected": {
                  "$ref": "urn:resina:schema:slider-edit-result:0.1.0"
                },
                "error": {
                  "enum": [
                    "invalidRevision",
                    "invalidPosition",
                    "incoherentLayout",
                    "position",
                    "adjustment"
                  ]
                }
              },
              "oneOf": [
                {
                  "required": [
                    "expected"
                  ],
                  "not": {
                    "required": [
                      "error"
                    ]
                  }
                },
                {
                  "required": [
                    "error"
                  ],
                  "not": {
                    "required": [
                      "expected"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:slider-edit-cases:0.1.0"
}
