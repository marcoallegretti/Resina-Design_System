{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:opaque-pigment-request:0.1.0",
  "title": "Resina Opaque Material Pigment Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "materialFamily", "body", "profiles"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "materialFamily": {"enum": ["cast", "frost", "elastomer", "gel"]},
    "body": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
    "profiles": {"$ref": "urn:resina:schema:opaque-pigment-profiles:0.1.0"}
  }
}
