{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-layout-request:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackSize",
    "thumbSize",
    "insets",
    "layoutDirection",
    "checked"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "trackSize": {
      "$ref": "urn:resina:schema:hit-region-request:0.1.0#/$defs/size"
    },
    "thumbSize": {
      "$ref": "urn:resina:schema:hit-region-request:0.1.0#/$defs/size"
    },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "top",
        "bottom"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "layoutDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "checked": {
      "type": "boolean"
    }
  }
}
