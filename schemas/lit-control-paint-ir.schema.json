{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:lit-control-paint-ir:0.1.0",
  "title": "Resina Lit Control Paint IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "body"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "body": {
      "$ref": "urn:resina:schema:lit-control-body-ir:0.1.0"
    },
    "focus": {
      "$ref": "urn:resina:schema:surface-paint-ir:0.1.0#/properties/focus"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "body": {
            "properties": {
              "states": {
                "properties": {
                  "states": {
                    "contains": {
                      "const": "focused"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "focus"
        ]
      },
      "else": {
        "not": {
          "required": [
            "focus"
          ]
        }
      }
    }
  ]
}
