{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:state-set:0.1.0",
  "title": "Resina Interaction State Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["rest", "hover", "focused", "pressed", "active", "selected", "checked", "disabled", "busy", "dragging", "error", "warning", "success"]
      }
    }
  }
}
