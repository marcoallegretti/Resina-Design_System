{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-accessibility-case:0.1.0",
  "title": "Resina Ordinary Command Accessibility Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "input"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labelText",
        "description",
        "activation",
        "focusable"
      ],
      "properties": {
        "labelText": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "activation": {
          "$ref": "urn:resina:schema:activation-state:0.1.0"
        },
        "focusable": {
          "type": "boolean"
        }
      }
    },
    "expected": {
      "$ref": "urn:resina:schema:command-accessibility-ir:0.1.0"
    },
    "error": {
      "enum": [
        "BlankDescription",
        "EnabledNotFocusable",
        "FocusedNotFocusable"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "expected"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "expected"
        ]
      }
    }
  ]
}
