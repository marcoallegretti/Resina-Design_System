{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-profile-ir:0.1.0",
  "title": "Resina Toggle Layout Profile Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "densityPreference", "layoutDirection", "trackSize", "thumbSize", "insets"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "densityPreference": { "enum": ["compact", "standard", "comfortable", "immersive"] },
    "layoutDirection": { "enum": ["ltr", "rtl"] },
    "trackSize": { "$ref": "#/$defs/size" },
    "thumbSize": { "$ref": "#/$defs/size" },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "top", "bottom"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "top": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
