{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:material-light-result:0.1.0",
  "title": "Resina Material Light Result",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "pigment", "keyDirection", "ambient", "interaction", "colorRanges", "samples"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "pigment": {"$ref": "urn:resina:schema:opaque-pigment-result:0.1.0"},
    "keyDirection": {"$ref": "urn:resina:schema:key-light-result:0.1.0#/properties/direction"},
    "ambient": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "interaction": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["direction", "strength"],
          "properties": {
            "direction": {"$ref": "urn:resina:schema:key-light-result:0.1.0#/properties/direction"},
            "strength": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          }
        }
      ]
    },
    "colorRanges": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "urn:resina:schema:opaque-srgb-range:0.1.0"}
    },
    "samples": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["weight", "color"],
        "properties": {
          "weight": {"type": "number", "minimum": -1, "maximum": 1},
          "color": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"}
        }
      }
    }
  }
}
