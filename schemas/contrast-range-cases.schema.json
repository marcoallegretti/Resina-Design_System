{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:contrast-range-cases:0.1.0",
  "title": "Resina Contrast Range Cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "foreground",
      "range"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "foreground": {
        "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
      },
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lower",
          "upper"
        ],
        "properties": {
          "lower": {
            "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
          },
          "upper": {
            "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
          }
        }
      },
      "expected": {
        "type": "number",
        "minimum": 1,
        "maximum": 21
      },
      "error": {
        "type": "string",
        "minLength": 1
      }
    },
    "oneOf": [
      {
        "required": [
          "expected"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "expected"
          ]
        }
      }
    ]
  }
}
