{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:hit-membership-case:0.1.0",
  "title": "Resina Rectangular Hit Membership Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "bounds", "points"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "bounds": {"$ref": "urn:resina:schema:hit-region-request:0.1.0#/$defs/bounds"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "expected"],
        "properties": {
          "x": {"type": "number"},
          "y": {"type": "number"},
          "expected": {"type": "boolean"}
        }
      }
    }
  }
}
