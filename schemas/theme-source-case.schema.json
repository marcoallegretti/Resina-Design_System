{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-source-case:0.1.0",
  "title": "Resina Theme Source Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "outcome", "schemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["valid", "invalid"]},
    "schemaValid": {"type": "boolean"},
    "sourceChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "value": {}
        }
      }
    },
    "sourceReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "with"],
      "properties": {
        "find": {"type": "string", "minLength": 1},
        "with": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"if": {"required": ["sourceReplace"]}, "then": {"not": {"required": ["sourceChanges"]}}},
    {"if": {"properties": {"outcome": {"const": "valid"}}}, "then": {"properties": {"schemaValid": {"const": true}}}}
  ]
}
