{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-emergence-result:0.1.0",
  "title": "Resina Surface Emergence Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "identity",
    "progress",
    "opacity",
    "projection",
    "origin",
    "outline",
    "fromContent",
    "toContent",
    "reservation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "policy": {
      "enum": [
        "spring",
        "castImmediate",
        "reducedMotion"
      ]
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "progress": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "opacity": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progress",
        "opacity"
      ],
      "properties": {
        "progress": {
          "enum": [
            "none",
            "lowerBound",
            "upperBound"
          ]
        },
        "opacity": {
          "enum": [
            "none",
            "lowerBound",
            "upperBound"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "outline": {
      "$ref": "urn:resina:schema:surface-outline-result:0.1.0"
    },
    "fromContent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "opacity"
          ],
          "properties": {
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "opacity": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "toContent": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "opacity"
          ],
          "properties": {
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "opacity": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
