{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:theme-derivation-result:0.1.0",
  "title": "Resina Theme Derivation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seed", "themes"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "seed": {"$ref": "#/$defs/seed"},
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {"$ref": "#/$defs/theme"},
        "dark": {"$ref": "#/$defs/theme"}
      }
    }
  },
  "$defs": {
    "oklch": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": false,
      "prefixItems": [
        {"type": "number"},
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0, "exclusiveMaximum": 360}
      ]
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oklch", "achromatic"],
      "properties": {
        "oklch": {"$ref": "#/$defs/oklch"},
        "achromatic": {"type": "boolean"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetOklch", "color"],
      "properties": {
        "targetOklch": {"$ref": "#/$defs/oklch"},
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["colorSpace", "components"],
          "properties": {
            "colorSpace": {"const": "srgb"},
            "components": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent.primary", "accent.secondary", "accent.tertiary", "focus", "selection"],
      "properties": {
        "accent.primary": {"$ref": "#/$defs/role"},
        "accent.secondary": {"$ref": "#/$defs/role"},
        "accent.tertiary": {"$ref": "#/$defs/role"},
        "focus": {"$ref": "#/$defs/role"},
        "selection": {"$ref": "#/$defs/role"}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "roles", "legibilityGuard"],
      "properties": {
        "source": {"$ref": "urn:resina:schema:theme-source:0.1.0"},
        "roles": {"$ref": "#/$defs/roles"},
        "legibilityGuard": {"$ref": "urn:resina:schema:theme-legibility-guard:0.1.0"}
      }
    }
  }
}
