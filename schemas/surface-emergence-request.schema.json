{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-emergence-request:0.1.0",
  "title": "Resina Surface Emergence Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "reducedMotion",
    "time",
    "emerged",
    "from",
    "to",
    "sweepOffset",
    "channels"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "family": {
      "enum": [
        "cast",
        "frost",
        "elastomer",
        "gel"
      ]
    },
    "reducedMotion": {
      "type": "boolean"
    },
    "time": {
      "type": "number",
      "minimum": 0
    },
    "emerged": {
      "type": "boolean"
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "outline",
        "origin",
        "content"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "outline": {
          "$ref": "urn:resina:schema:surface-outline-request:0.1.0"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "outline",
        "origin",
        "content"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "outline": {
          "$ref": "urn:resina:schema:surface-outline-request:0.1.0"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "sweepOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progress",
        "opacity"
      ],
      "properties": {
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dynamics",
            "initial"
          ],
          "properties": {
            "dynamics": {
              "$ref": "urn:resina:schema:spring-dynamics:0.1.0"
            },
            "initial": {
              "$ref": "urn:resina:schema:spring-state:0.1.0"
            }
          }
        },
        "opacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dynamics",
            "initial"
          ],
          "properties": {
            "dynamics": {
              "$ref": "urn:resina:schema:spring-dynamics:0.1.0"
            },
            "initial": {
              "$ref": "urn:resina:schema:spring-state:0.1.0"
            }
          }
        }
      }
    }
  }
}
