{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:slider-adjustment-cases:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "current",
          "enabled",
          "readOnly",
          "adjustment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "$ref": "urn:resina:schema:slider-value-request:0.1.0"
          },
          "enabled": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          },
          "adjustment": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "setValue"
                  },
                  "value": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "amount"
                ],
                "properties": {
                  "kind": {
                    "const": "increase"
                  },
                  "amount": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "amount"
                ],
                "properties": {
                  "kind": {
                    "const": "decrease"
                  },
                  "amount": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "minimum"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "maximum"
                  }
                }
              }
            ]
          },
          "expected": {
            "$ref": "urn:resina:schema:slider-adjustment-ir:0.1.0"
          },
          "error": {
            "enum": [
              "invalidValue",
              "invalidAmount",
              "numericRange",
              "value"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        ]
      }
    }
  }
}
