{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-outline-request:0.1.0",
  "title": "Resina Surface Outline Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "size",
    "radii",
    "layoutDirection",
    "curvature",
    "minimumInset"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "radii": {
      "$ref": "urn:resina:schema:logical-corner-radii:0.1.0"
    },
    "layoutDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "curvature": {
      "enum": [
        "circular",
        "quartic"
      ]
    },
    "minimumInset": {
      "type": "number",
      "minimum": 0
    }
  }
}
