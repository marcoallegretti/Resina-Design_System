{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:focus-indicator-result:0.1.0",
  "title": "Resina Focus Indicator Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "binding", "colorRole", "color", "contrastRatio", "fallbackApplied", "strokeWidth", "gap"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "binding": {
      "allOf": [
        {"$ref": "urn:resina:schema:surface-binding-result:0.4.0"},
        {"properties": {"states": {"properties": {"states": {"contains": {"const": "focused"}}}}}}
      ]
    },
    "colorRole": {"enum": ["focus", "outline.strong"]},
    "color": {"$ref": "urn:resina:schema:opaque-srgb-fallback:0.1.0"},
    "contrastRatio": {"type": "number", "minimum": 3, "maximum": 21},
    "fallbackApplied": {"type": "boolean"},
    "strokeWidth": {"const": 2},
    "gap": {"const": 2}
  },
  "allOf": [
    {"if": {"properties": {"fallbackApplied": {"const": true}}}, "then": {"properties": {"colorRole": {"const": "outline.strong"}}}, "else": {"properties": {"colorRole": {"const": "focus"}}}}
  ],
  "$comment": "The resolver checks semantic color binding and contrast against the supplied surrounding color."
}
