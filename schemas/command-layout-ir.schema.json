{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-layout-ir:0.1.0",
  "title": "Resina Command Layout Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "densityPreference", "layoutDirection", "minimumSize", "maximumSize",
    "padding", "targetMinimum"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "densityPreference": { "enum": ["compact", "standard", "comfortable", "immersive"] },
    "layoutDirection": { "enum": ["ltr", "rtl"] },
    "minimumSize": { "$ref": "#/$defs/size" },
    "maximumSize": { "$ref": "#/$defs/size" },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "top", "bottom"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "top": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 }
      }
    },
    "targetMinimum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "enum": [24, 48] },
        "height": { "enum": [24, 48] }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
