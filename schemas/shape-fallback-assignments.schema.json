{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:shape-fallback-assignments:0.1.0",
  "title": "Resina Tier 0 Shape Fallback Assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural", "soft", "rounded", "capsule", "organic"],
      "properties": {
        "structural": {"$ref": "#/$defs/regularProfile"},
        "soft": {"$ref": "#/$defs/regularProfile"},
        "rounded": {"$ref": "#/$defs/regularProfile"},
        "capsule": {"$ref": "#/$defs/capsuleProfile"},
        "organic": {"$ref": "#/$defs/cornerProfile"}
      }
    }
  },
  "$defs": {
    "tokenPath": {"type": "string", "minLength": 1},
    "regularProfile": {
      "oneOf": [
        {"$ref": "#/$defs/uniformProfile"},
        {"$ref": "#/$defs/cornerProfile"}
      ]
    },
    "uniformProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radius"],
      "properties": {
        "kind": {"const": "uniform"},
        "radius": {"$ref": "#/$defs/tokenPath"}
      }
    },
    "cornerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "radii"],
      "properties": {
        "kind": {"const": "corners"},
        "radii": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topStart", "topEnd", "bottomEnd", "bottomStart"],
          "properties": {
            "topStart": {"$ref": "#/$defs/tokenPath"},
            "topEnd": {"$ref": "#/$defs/tokenPath"},
            "bottomEnd": {"$ref": "#/$defs/tokenPath"},
            "bottomStart": {"$ref": "#/$defs/tokenPath"}
          }
        }
      }
    },
    "capsuleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "capsule"}}
    }
  }
}
