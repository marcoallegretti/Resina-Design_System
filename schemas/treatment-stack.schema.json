{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:treatment-stack:0.1.0",
  "title": "Resina Optical Treatment Stack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "treatments"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["none", "lens", "focusLens", "highlightLens"]},
      "contains": {"enum": ["lens", "focusLens", "highlightLens"]},
      "minContains": 0,
      "maxContains": 1
    }
  }
}
