{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-relief-result:0.1.0",
  "title": "Resina Surface Relief Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline",
        "profile",
        "contentBounds"
      ],
      "properties": {
        "outline": {
          "$ref": "urn:resina:schema:surface-outline-result:0.1.0"
        },
        "profile": {
          "$ref": "urn:resina:schema:surface-relief-request:0.1.0#/$defs/profile"
        },
        "contentBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point",
          "sample"
        ],
        "properties": {
          "point": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "sample": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "height",
                  "normal"
                ],
                "properties": {
                  "height": {
                    "type": "number"
                  },
                  "normal": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "z": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
