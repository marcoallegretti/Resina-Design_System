{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:common-contrast-cases:0.1.0",
  "title": "Resina Common Contrast Cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "preferred",
      "fallback",
      "backgrounds"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "preferred": {
        "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
      },
      "fallback": {
        "$ref": "urn:resina:schema:srgb-fallback:0.1.0"
      },
      "backgrounds": {
        "type": "array",
        "items": {
          "$ref": "urn:resina:schema:opaque-srgb-range:0.1.0"
        }
      },
      "error": {
        "enum": [
          "empty",
          "insufficient"
        ]
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "contrastRatio"
        ],
        "properties": {
          "candidate": {
            "enum": [
              "preferred",
              "fallback"
            ]
          },
          "contrastRatio": {
            "type": "number",
            "minimum": 3,
            "maximum": 21
          }
        }
      },
      "candidateBounds": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preferred",
          "fallback"
        ],
        "properties": {
          "preferred": {
            "type": "number",
            "minimum": 1,
            "maximum": 21
          },
          "fallback": {
            "type": "number",
            "minimum": 1,
            "maximum": 21
          }
        }
      }
    },
    "oneOf": [
      {
        "required": [
          "expected",
          "candidateBounds"
        ],
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "backgrounds": {
            "minItems": 1
          }
        }
      },
      {
        "required": [
          "error",
          "candidateBounds"
        ],
        "not": {
          "required": [
            "expected"
          ]
        },
        "properties": {
          "error": {
            "const": "insufficient"
          },
          "backgrounds": {
            "minItems": 1
          }
        }
      },
      {
        "required": [
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "expected"
              ]
            },
            {
              "required": [
                "candidateBounds"
              ]
            }
          ]
        },
        "properties": {
          "error": {
            "const": "empty"
          },
          "backgrounds": {
            "maxItems": 0
          }
        }
      }
    ]
  }
}
