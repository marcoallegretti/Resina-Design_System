{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:environmental-pigment-request:0.1.0",
  "title": "Resina Environmental Pigment Adaptation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "accessibilityPreferences", "templates", "externalSources"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "profile": {"$ref": "urn:resina:schema:environmental-pigment-profile:0.1.0"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {
            "lower": {"$ref": "#/$defs/color"},
            "upper": {"$ref": "#/$defs/color"}
          }
        }
      }
    },
    "accessibilityPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reducedMotion", "reducedTransparency", "highContrast"],
      "properties": {
        "reducedMotion": {"type": "boolean"},
        "reducedTransparency": {"type": "boolean"},
        "highContrast": {"type": "boolean"}
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {"type": "string", "minLength": 1},
        "dark": {"type": "string", "minLength": 1}
      }
    },
    "externalSources": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorSpace", "components"],
      "properties": {
        "colorSpace": {"const": "srgb"},
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
