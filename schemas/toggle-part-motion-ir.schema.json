{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-part-motion-ir:0.1.0",
  "title": "Resina Toggle Part Motion IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "target",
    "bodyMix",
    "depthScale",
    "bodyMixProjection",
    "depthScaleProjection",
    "partPaint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "policy": {
      "enum": [
        "spring",
        "castImmediate",
        "reducedMotion"
      ]
    },
    "target": {
      "$ref": "urn:resina:schema:command-appearance:0.1.0#/$defs/response"
    },
    "bodyMix": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "depthScale": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "bodyMixProjection": {
      "enum": [
        "none",
        "lowerBound",
        "upperBound"
      ]
    },
    "depthScaleProjection": {
      "enum": [
        "none",
        "lowerBound",
        "upperBound"
      ]
    },
    "partPaint": {
      "$ref": "urn:resina:schema:toggle-part-paint-ir:0.1.0#/$defs/sampled"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "spring"
          }
        }
      },
      "then": {
        "properties": {
          "bodyMix": {
            "properties": {
              "representation": {
                "const": "spring"
              }
            }
          },
          "depthScale": {
            "properties": {
              "representation": {
                "const": "spring"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "const": "castImmediate"
          }
        }
      },
      "then": {
        "properties": {
          "bodyMix": {
            "properties": {
              "representation": {
                "const": "immediate"
              }
            }
          },
          "depthScale": {
            "properties": {
              "representation": {
                "const": "immediate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "const": "reducedMotion"
          }
        }
      },
      "then": {
        "properties": {
          "bodyMix": {
            "properties": {
              "representation": {
                "const": "immediate"
              }
            }
          },
          "depthScale": {
            "properties": {
              "representation": {
                "const": "immediate"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "partPaint": {
            "properties": {
              "phase": {
                "const": "rest"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "const": {
              "bodyMix": 0,
              "depthScale": 1
            }
          }
        }
      }
    }
  ]
}
