{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:frost-legibility-case:0.1.0",
  "title": "Resina Frost Legibility Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "request", "requestSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "requestSchemaValid": {"type": "boolean"},
    "expected": {"$ref": "urn:resina:schema:frost-legibility-result:0.1.0"},
    "errorContains": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {"required": ["expected"], "not": {"required": ["errorContains"]}},
    {"required": ["errorContains"], "not": {"required": ["expected"]}}
  ]
}
