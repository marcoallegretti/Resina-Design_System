{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:extruded-contour-result:0.1.0",
  "title": "Resina Extruded Contour Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bounds", "segments"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "bounds": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
  },
  "oneOf": [
    {"properties": {"bounds": {"type": "null"}, "segments": {"maxItems": 0}}},
    {"properties": {"bounds": {"type": "object"}, "segments": {"minItems": 1}}}
  ],
  "$defs": {
    "vector": {"$ref": "urn:resina:schema:physical-vector:0.1.0"},
    "radial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": -1, "maximum": 1},
        "y": {"type": "number", "minimum": -1, "maximum": 1}
      },
      "not": {"properties": {"x": {"const": 0}, "y": {"const": 0}}}
    },
    "segment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": {"const": "line"},
            "from": {"$ref": "#/$defs/vector"},
            "to": {"$ref": "#/$defs/vector"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "center", "radii", "start", "end"],
          "properties": {
            "kind": {"const": "arc"},
            "center": {"$ref": "#/$defs/vector"},
            "radii": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {"type": "number", "exclusiveMinimum": 0},
                "y": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "start": {"$ref": "#/$defs/radial"},
            "end": {"$ref": "#/$defs/radial"}
          }
        }
      ]
    }
  }
}
