{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:hit-region-request:0.1.0",
  "title": "Resina Rectangular Hit Region Request",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "environment", "visualBounds", "availableBounds", "componentMinimum", "occupiedRegions"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "environment": {"$ref": "urn:resina:schema:environment:0.2.0"},
    "visualBounds": {"$ref": "#/$defs/bounds"},
    "availableBounds": {"$ref": "#/$defs/bounds"},
    "componentMinimum": {"$ref": "#/$defs/size"},
    "occupiedRegions": {"type": "array", "items": {"$ref": "#/$defs/bounds"}}
  },
  "$defs": {
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "size": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    }
  }
}
