{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:opaque-paint-range-cases:0.1.0",
  "title": "Resina Opaque Paint Range Cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "family",
      "body",
      "sideShade",
      "highlightLift",
      "highlightWidth",
      "elevation",
      "radius",
      "expectedCount",
      "expectedHighlight"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "family": {
        "enum": [
          "cast",
          "frost",
          "elastomer",
          "gel"
        ]
      },
      "body": {
        "$ref": "#/$defs/channels"
      },
      "sideShade": {
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 1
      },
      "highlightLift": {
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 1
      },
      "highlightWidth": {
        "type": "number",
        "minimum": 0
      },
      "elevation": {
        "enum": [
          "base",
          "raised"
        ]
      },
      "radius": {
        "type": "number",
        "minimum": 0
      },
      "expectedCount": {
        "type": "integer",
        "minimum": 2,
        "maximum": 4
      },
      "expectedHighlight": {
        "$ref": "#/$defs/channels"
      }
    }
  },
  "$defs": {
    "channels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
