{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-paint-case:0.1.0",
  "title": "Resina Surface Paint Conformance Case",
  "type": "object", "additionalProperties": false,
  "required": ["name", "requestChanges", "requestSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "requestChanges": {"$ref": "urn:resina:schema:opaque-surface-case:0.1.0#/$defs/changes"},
    "requestSchemaValid": {"type": "boolean"},
    "omitSurroundingColor": {"type": "boolean"},
    "expectedFocus": {"type": "boolean"},
    "failure": {"const": true}
  },
  "oneOf": [
    {"required": ["expectedFocus"], "not": {"required": ["failure"]}, "properties": {"requestSchemaValid": {"const": true}}},
    {"required": ["failure"], "not": {"required": ["expectedFocus"]}}
  ]
}
