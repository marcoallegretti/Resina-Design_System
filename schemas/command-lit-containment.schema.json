{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-lit-containment:0.1.0",
  "title": "Complete label layout-box containment in a lit command body",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "radius", "profile", "cases"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "radius": {"type": "number", "exclusiveMinimum": 0},
    "profile": {"$ref": "urn:resina:schema:surface-relief-request:0.1.0#/$defs/profile"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "textScale", "size", "shoulderWidth", "padding", "labelHeight", "contained"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "textScale": {"type": "number", "exclusiveMinimum": 0},
        "size": {"allOf": [
          {"$ref": "urn:resina:schema:surface-size:0.1.0"},
          {"properties": {"width": {"exclusiveMinimum": 0}, "height": {"exclusiveMinimum": 0}}}
        ]},
        "shoulderWidth": {"type": "number", "exclusiveMinimum": 0},
        "padding": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end", "top", "bottom"],
          "properties": {
            "start": {"type": "number", "minimum": 0},
            "end": {"type": "number", "minimum": 0},
            "top": {"type": "number", "minimum": 0},
            "bottom": {"type": "number", "minimum": 0}
          }
        },
        "labelHeight": {"type": "number", "exclusiveMinimum": 0},
        "contained": {"type": "boolean"}
      }
    }}
  }
}
