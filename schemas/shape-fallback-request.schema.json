{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:shape-fallback-request:0.1.0",
  "title": "Resina Tier 0 Shape Fallback Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tokens", "assignments", "shape", "size"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "tokens": {"type": "object"},
    "assignments": {"$ref": "urn:resina:schema:shape-fallback-assignments:0.1.0"},
    "shape": {"enum": ["structural", "soft", "rounded", "capsule", "organic"]},
    "size": {"$ref": "urn:resina:schema:surface-size:0.1.0"}
  }
}
