{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:outline-focus-result:0.1.0",
  "title": "Resina Outline Focus Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "focus", "supports"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "focus": {"$ref": "urn:resina:schema:outline-focus-ir:0.1.0"},
    "supports": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["normal", "silhouette", "inner", "outer"],
        "properties": {
          "normal": {"$ref": "urn:resina:schema:outline-focus-ir:0.1.0#/$defs/vector"},
          "silhouette": {"$ref": "#/$defs/boundary"},
          "inner": {"$ref": "#/$defs/boundary"},
          "outer": {"$ref": "#/$defs/boundary"}
        }
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["point", "support"],
      "properties": {
        "point": {"$ref": "urn:resina:schema:outline-focus-ir:0.1.0#/$defs/vector"},
        "support": {"type": "number"}
      }
    }
  }
}
