{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-paint-request:0.2.0",
  "title": "Resina Command Paint Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "commandAppearance",
    "light",
    "relief"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "surface": {
      "$ref": "urn:resina:schema:surface-paint-request:0.1.0"
    },
    "commandAppearance": {
      "$ref": "urn:resina:schema:command-appearance:0.1.0"
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient",
        "interaction"
      ],
      "properties": {
        "ambient": {
          "$ref": "urn:resina:schema:material-light:0.1.0#/properties/ambient"
        },
        "interaction": {
          "$ref": "urn:resina:schema:material-light:0.1.0#/properties/interaction"
        }
      }
    },
    "relief": {
      "$ref": "urn:resina:schema:control-relief:0.1.0"
    }
  }
}
