{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:slider-key-cases:0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "current",
          "valuePolicy",
          "keyPolicy",
          "key",
          "enabled",
          "readOnly",
          "focused"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "$ref": "urn:resina:schema:slider-value-request:0.1.0"
          },
          "valuePolicy": {
            "$ref": "urn:resina:schema:slider-value-policy-fixture:0.1.0"
          },
          "keyPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps",
              "increaseOnRight",
              "increaseOnUp"
            ],
            "properties": {
              "steps": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "step",
                      "page"
                    ],
                    "properties": {
                      "kind": {
                        "const": "continuous"
                      },
                      "step": {
                        "type": "number"
                      },
                      "page": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "step",
                      "page"
                    ],
                    "properties": {
                      "kind": {
                        "const": "stops"
                      },
                      "step": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 18446744073709551615
                      },
                      "page": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 18446744073709551615
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "increaseOnRight": {
                "type": "boolean"
              },
              "increaseOnUp": {
                "type": "boolean"
              }
            }
          },
          "key": {
            "enum": [
              "arrowRight",
              "arrowLeft",
              "arrowUp",
              "arrowDown",
              "home",
              "end",
              "pageUp",
              "pageDown"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "expected": {
            "$ref": "urn:resina:schema:slider-key-ir:0.1.0"
          },
          "error": {
            "enum": [
              "invalidStep",
              "invalidPage",
              "policyMismatch",
              "valuePolicy",
              "adjustment"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        ]
      }
    }
  }
}
