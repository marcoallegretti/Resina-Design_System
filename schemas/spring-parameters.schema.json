{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:spring-parameters:0.1.0",
  "title": "Resina spring-parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mass",
    "stiffness",
    "damping",
    "initialVelocity",
    "positionThreshold",
    "velocityThreshold"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "mass": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stiffness": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "damping": {
      "type": "number",
      "minimum": 0
    },
    "initialVelocity": {
      "type": "number"
    },
    "positionThreshold": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "velocityThreshold": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
