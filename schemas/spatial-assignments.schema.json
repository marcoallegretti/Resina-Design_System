{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:spatial-assignments:0.2.0",
  "title": "Resina Spatial Assignments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roles"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space.control.inline", "space.control.block", "space.control.inset.inline",
        "space.control.inset.block", "space.container.inner", "space.container.outer",
        "space.group", "space.section", "space.page"
      ],
      "properties": {
        "space.control.inline": { "$ref": "#/$defs/tokenPath" },
        "space.control.block": { "$ref": "#/$defs/tokenPath" },
        "space.control.inset.inline": { "$ref": "#/$defs/densityTokenPaths" },
        "space.control.inset.block": { "$ref": "#/$defs/densityTokenPaths" },
        "space.container.inner": { "$ref": "#/$defs/tokenPath" },
        "space.container.outer": { "$ref": "#/$defs/tokenPath" },
        "space.group": { "$ref": "#/$defs/tokenPath" },
        "space.section": { "$ref": "#/$defs/tokenPath" },
        "space.page": { "$ref": "#/$defs/tokenPath" }
      }
    }
  },
  "$defs": {
    "tokenPath": { "type": "string", "minLength": 1 },
    "densityTokenPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compact", "standard", "comfortable", "immersive"],
      "properties": {
        "compact": { "$ref": "#/$defs/tokenPath" },
        "standard": { "$ref": "#/$defs/tokenPath" },
        "comfortable": { "$ref": "#/$defs/tokenPath" },
        "immersive": { "$ref": "#/$defs/tokenPath" }
      }
    }
  }
}
