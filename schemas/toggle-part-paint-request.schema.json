{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-part-paint-request:0.2.0",
  "title": "Resina Toggle Part Paint Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "part",
    "surface",
    "checkedColorRole",
    "interactionAppearance",
    "light",
    "relief"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "surface": {
      "$ref": "urn:resina:schema:surface-paint-request:0.1.0"
    },
    "interactionAppearance": {
      "$ref": "urn:resina:schema:command-appearance:0.1.0"
    },
    "light": {
      "$ref": "urn:resina:schema:command-paint-request:0.2.0#/properties/light"
    },
    "relief": {
      "$ref": "urn:resina:schema:command-paint-request:0.2.0#/properties/relief"
    },
    "part": {
      "enum": [
        "track",
        "thumb"
      ]
    },
    "checkedColorRole": {
      "$ref": "urn:resina:schema:surface-binding:0.2.0#/properties/colorRole"
    }
  }
}
