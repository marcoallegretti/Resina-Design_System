{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-content-case:0.1.0",
  "title": "Resina Command Content Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "document", "schemaValid"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "document": {},
    "schemaValid": { "type": "boolean" },
    "error": { "type": "string", "minLength": 1 }
  },
  "if": { "not": { "required": ["error"] } },
  "then": { "properties": { "schemaValid": { "const": true } } }
}
