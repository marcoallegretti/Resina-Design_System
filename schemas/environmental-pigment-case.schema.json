{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:environmental-pigment-case:0.1.0",
  "title": "Resina Environmental Pigment Adaptation Conformance Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "outcome",
    "requestSchemaValid"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "requestSchemaValid": {
      "type": "boolean"
    },
    "observation": {},
    "accessibilityPreferences": {},
    "templateVariant": {
      "const": "embeddedTokens"
    },
    "templateChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "path",
          "value"
        ],
        "properties": {
          "theme": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "requestChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "requestOmit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "requestDocument": {},
    "failingThemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "light",
          "dark"
        ]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptation",
        "themes"
      ],
      "properties": {
        "adaptation": {
          "$ref": "urn:resina:schema:environmental-pigment-result:0.1.0#/properties/adaptation"
        },
        "themes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "light",
            "dark"
          ],
          "properties": {
            "light": {
              "$ref": "#/$defs/expectedTheme"
            },
            "dark": {
              "$ref": "#/$defs/expectedTheme"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "expectedTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "legibilityGuard"
      ],
      "properties": {
        "roles": {
          "$ref": "urn:resina:schema:environmental-pigment-result:0.1.0#/$defs/roles"
        },
        "frostCertification": {
          "$ref": "urn:resina:schema:environmental-pigment-result:0.1.0#/$defs/frostCertification"
        },
        "legibilityGuard": {
          "$ref": "urn:resina:schema:theme-legibility-guard:0.1.0"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "valid"
          }
        }
      },
      "then": {
        "required": [
          "expected"
        ],
        "properties": {
          "requestSchemaValid": {
            "const": true
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "failingThemes"
              ]
            },
            {
              "required": [
                "requestDocument"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "expected"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "requestDocument"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "observation"
              ]
            },
            {
              "required": [
                "accessibilityPreferences"
              ]
            },
            {
              "required": [
                "templateVariant"
              ]
            },
            {
              "required": [
                "templateChanges"
              ]
            },
            {
              "required": [
                "requestChanges"
              ]
            },
            {
              "required": [
                "requestOmit"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "failingThemes"
        ]
      },
      "then": {
        "properties": {
          "requestSchemaValid": {
            "const": true
          }
        }
      }
    }
  ]
}
