{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:toggle-profile-request:0.1.0",
  "title": "Resina Toggle Layout Profile Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "tokens", "environment", "availableSize"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
