{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:surface-deformation-result:0.1.0",
  "title": "Resina Surface Deformation Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "widthScale",
    "heightScale",
    "projection",
    "origin",
    "outline",
    "reservation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "policy": {
      "enum": [
        "spring",
        "castImmediate",
        "reducedMotion"
      ]
    },
    "widthScale": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "heightScale": {
      "$ref": "urn:resina:schema:spring-trajectory-result:0.1.0"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widthScale",
        "heightScale"
      ],
      "properties": {
        "widthScale": {
          "enum": [
            "none",
            "lowerBound",
            "upperBound"
          ]
        },
        "heightScale": {
          "enum": [
            "none",
            "lowerBound",
            "upperBound"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "outline": {
      "$ref": "urn:resina:schema:surface-outline-result:0.1.0"
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
