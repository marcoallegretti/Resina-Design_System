{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:command-label-ir:0.1.0",
  "title": "Resina Complete Command Label Layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "text",
    "typography",
    "size",
    "labelBounds",
    "layoutDirection"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "typography": {
      "$ref": "urn:resina:schema:headless-result:0.4.0#/$defs/typography"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "labelBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "layoutDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    }
  }
}
