{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resina:schema:extruded-contour-case:0.1.0",
  "title": "Resina Extruded Contour Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "request", "requestSchemaValid"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "requestSchemaValid": {"type": "boolean"},
    "expected": {"$ref": "urn:resina:schema:extruded-contour-result:0.1.0"},
    "errorContains": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {
      "required": ["expected"],
      "not": {"required": ["errorContains"]},
      "properties": {"requestSchemaValid": {"const": true}}
    },
    {"required": ["errorContains"], "not": {"required": ["expected"]}}
  ]
}
